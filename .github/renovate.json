{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["local>reactiveui/.github:renovate"],
    "packageRules": [
        {
            "description": "Include the Citrus controls in the shared Avalonia group.",
            "matchManagers": ["nuget"],
            "matchPackageNames": ["Citrus.Avalonia"],
            "groupName": "Avalonia"
        }
    ]
}
