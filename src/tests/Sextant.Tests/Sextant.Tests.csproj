<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(SextantModernTargets)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>    
    <Nullable>enable</Nullable>    
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sextant.Mocks\Sextant.Mocks.csproj" />
    <ProjectReference Include="../../Sextant/Sextant.csproj" />
    <ProjectReference Include="../../Sextant.Avalonia/Sextant.Avalonia.csproj" />
    <ProjectReference Include="../../Sextant.Plugins.Popup/Sextant.Plugins.Popup.csproj" />
  </ItemGroup>
  
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
    <ProjectReference Include="../../Sextant.Maui/Sextant.Maui.csproj" />
  </ItemGroup>
  
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
    <DefineConstants>$(DefineConstants);HAS_MAUI</DefineConstants>
  </PropertyGroup>
</Project>
