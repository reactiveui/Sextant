<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(SextantCoreTargets)</TargetFrameworks>
    <RootNamespace>Sextant</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  
  <ItemGroup>
    <Compile Remove="Platforms\**\*.cs" />
    <None Include="Platforms\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sextant.Tests" />
    <InternalsVisibleTo Include="Sextant.Plugins.Popup" />
    <InternalsVisibleTo Include="Sextant.State.Tests" />
    <PackageReference Include="ReactiveUI.Reactive" />
  </ItemGroup>
  
  
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
    <Compile Include="Platforms\net\**\*.cs" />
  </ItemGroup>
</Project>
