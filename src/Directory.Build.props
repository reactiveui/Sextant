<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Copyright>Copyright (c) ReactiveUI and Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/reactiveui/sextant/</PackageProjectUrl>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>ReactiveUI and Contributors</Authors>
    <PackageTags>mvvm;reactiveui;rx;reactive extensions;observable;navigation;avalonia;maui;android;ios;macos;windows</PackageTags>
    <Description>ReactiveUI navigation for Avalonia and .NET MAUI applications.</Description>
    <PackageReleaseNotes>https://github.com/reactiveui/sextant/releases</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/reactiveui/sextant</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTestProject Condition="'$(IsTestProject)' == ''">$(MSBuildProjectName.EndsWith('.Tests'))</IsTestProject>
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable;CS4014</WarningsAsErrors>
    <IncludePackageReferencesDuringMarkupCompilation>true</IncludePackageReferencesDuringMarkupCompilation>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <SextantModernTargets>net10.0;net11.0</SextantModernTargets>
    <SextantCoreTargets>$(SextantModernTargets)</SextantCoreTargets>
    <SextantAndroidTargets>net10.0-android;net11.0-android</SextantAndroidTargets>
    <SextantWindowsTargets>net10.0-windows10.0.19041.0;net11.0-windows10.0.19041.0</SextantWindowsTargets>
    <SextantAppleTargets>net10.0-ios;net10.0-macos;net10.0-maccatalyst;net10.0-tvos;net11.0-ios;net11.0-macos;net11.0-maccatalyst;net11.0-tvos</SextantAppleTargets>
  </PropertyGroup>

  <PropertyGroup>
    <SextantMauiTargetFrameworks>$(SextantCoreTargets);$(SextantAndroidTargets);$(SextantWindowsTargets)</SextantMauiTargetFrameworks>
    <SextantMauiTargetFrameworks Condition="$([MSBuild]::IsOsPlatform('Windows')) or $([MSBuild]::IsOsPlatform('OSX'))">$(SextantMauiTargetFrameworks);$(SextantAppleTargets)</SextantMauiTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="$(UseMaui) == 'true'">
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Condition="$(TargetFramework.StartsWith('net10'))" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <EnableVSTestReferences>false</EnableVSTestReferences>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TUnitImplicitUsings>true</TUnitImplicitUsings>
    <TUnitAssertionsImplicitUsings>true</TUnitAssertionsImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)testconfig.json">
      <Link>$(AssemblyName).testconfig.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\images\logo.png" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="LICENSE" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="StyleSharp.Analyzers" PrivateAssets="all" />
    <PackageReference Include="PerformanceSharp.Analyzers" PrivateAssets="all" />
    <PackageReference Include="SecuritySharp.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <TrackPublicApi Condition="'$(MSBuildProjectName)' == 'Sextant' or '$(MSBuildProjectName)' == 'Sextant.Avalonia' or '$(MSBuildProjectName)' == 'Sextant.Maui' or '$(MSBuildProjectName)' == 'Sextant.Plugins.Popup'">true</TrackPublicApi>
    <EnablePublicApiBaseline>$(TrackPublicApi)</EnablePublicApiBaseline>
  </PropertyGroup>
  <ItemGroup Condition="'$(TrackPublicApi)' == 'true'">
    <PackageReference Include="PublicApiSharp.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="ReactiveUI.Reactive" />
    <Using Include="ReactiveUI.Reactive.Builder" />
    <Using Include="ReactiveUI.Binding.Reactive" />
    <Using Include="ReactiveUI.Binding.Reactive.ObservableForProperty" />
  </ItemGroup>
  <PropertyGroup>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>4.1</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
</Project>
